# Node.js 22 이상. .env로 복사하면 npm start에서 읽습니다.
PORT=3000
# 비워두면 개발 전용: 127.0.0.1에만 열리고 관리자 로컬 미리보기 가능
ADMIN_PASSWORD=
# 공개 배포 전 production + 강력한 관리자 비밀번호 필수
NODE_ENV=development
HOST=127.0.0.1
# 운영 배포에서는 공개 https 주소 지정. 끝에 / 없이 입력
PUBLIC_ORIGIN=
# 카카오 로그인을 쓰려면 카카오디벨로퍼스에서 로그인 ON 및 아래 콜백 주소 등록
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=http://127.0.0.1:3000/api/auth/kakao/callback
# 쉼표로 구분한 카카오 앱 사용자 ID. 비워두면 누구도 관리자 세션을 받지 못함
# KAKAO_ADMIN_IDS=
